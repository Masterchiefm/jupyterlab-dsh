{
  "name": "jupyterlab-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) tab for JupyterLab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/jupyterlab/jupyterlab",
  "bugs": {
    "url": "https://github.com/jupyterlab/jupyterlab/issues"
  },
  "license": "MIT",
  "author": {
    "name": "jupyterlab-dsh contributors"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,.js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlab/jupyterlab.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:lib": "tsc -b",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyterlab-dsh-dist",
    "clean:all": "jlpm run clean:lib && jlpm run clean:labextension",
    "watch": "run-p watch:lib watch:labextension",
    "watch:lib": "tsc -b --watch",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^3.3.0 || ^4.0.0",
    "@jupyterlab/apputils": "^3.3.0 || ^4.0.0",
    "@jupyterlab/coreutils": "^5.3.0 || ^6.0.0",
    "@jupyterlab/launcher": "^3.3.0 || ^4.0.0",
    "@jupyterlab/translation": "^3.3.0 || ^4.0.0",
    "@jupyterlab/ui-components": "^3.3.0 || ^4.0.0",
    "@lumino/widgets": "^1.32.0 || ^2.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^3.3.0 || ^4.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "typescript": "~5.3.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab-dsh-dist",
    "sharedPackages": {
      "@jupyterlab/application": {
        "requiredVersion": "^3.3.0 || ^4.0.0"
      },
      "@jupyterlab/apputils": {
        "requiredVersion": "^3.3.0 || ^4.0.0"
      },
      "@jupyterlab/coreutils": {
        "requiredVersion": "^5.3.0 || ^6.0.0"
      },
      "@jupyterlab/launcher": {
        "requiredVersion": "^3.3.0 || ^4.0.0"
      },
      "@jupyterlab/translation": {
        "requiredVersion": "^3.3.0 || ^4.0.0"
      },
      "@jupyterlab/ui-components": {
        "requiredVersion": "^3.3.0 || ^4.0.0"
      },
      "@lumino/widgets": {
        "requiredVersion": "^1.32.0 || ^2.0.0"
      }
    }
  }
}
